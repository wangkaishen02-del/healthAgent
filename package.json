{
  "name": "health-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start": "concurrently -k -n web,api \"npm:start:web\" \"npm:start:api\"",
    "start:web": "next start",
    "start:api": "node dist/nest/apps/api/src/main.js",
    "test:assistant-graph": "AUTH_ENABLED=false LANGGRAPH_CHECKPOINTER=memory node --import tsx src/assistant/assistant-graph-smoke-test.ts",
    "test:assistant-privacy": "node --import tsx src/assistant/privacy-test.ts",
    "test:assistant-backend": "node --import tsx src/assistant/backend-tools-test.ts",
    "test:claim-state-machine": "node --import tsx src/claims/state-machine-test.ts",
    "test:claim-workflow": "tsx --tsconfig apps/api/tsconfig.json src/api/claim-workflow-smoke-test.ts",
    "test:assistant-graph:postgres": "node --import tsx src/assistant/assistant-graph-postgres-test.ts",
    "test:api": "AUTH_ENABLED=false tsx --tsconfig apps/api/tsconfig.json src/api/nest-smoke-test.ts",
    "test:auto-calculation": "AUTH_ENABLED=false tsx --tsconfig apps/api/tsconfig.json src/api/automatic-calculation-smoke-test.ts",
    "test:standard-formula": "AUTH_ENABLED=false tsx --tsconfig apps/api/tsconfig.json src/api/standard-formula-smoke-test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "jose": "^6.2.7",
    "next": "^16.0.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  }
}
