generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum HolderType {
  group
  company
}

enum PolicyStatus {
  enabled
  disabled
}

enum ProductStatus {
  active
  inactive
}

enum BenefitStatus {
  active
  inactive
}

enum Gender {
  male
  female
  unknown
}

enum IdType {
  id_card
  passport
  other
}

enum InsuredRole {
  employee
  spouse
  child
  parent
  other
}

enum CalculationParameterScope {
  policy
  plan
  product
  benefit
}

enum CalculationParameterValueType {
  text
  number
  percentage
  amount
  boolean
}

enum ClaimCaseStatus {
  registered
  submitted
  cancelled
}

enum ClaimPartyRole {
  insured
  applicant
  payee
}

enum ClaimEventType {
  disease
  accident
  other
}

enum ClaimReportChannel {
  online
  phone
  counter
  other
}

enum ClaimPaymentMethod {
  pending
  bank_transfer
  cash
  other
}

enum ClaimAttachmentCategory {
  application
  identity
  medical
  invoice
  bank
  other
}

model Policy {
  id               String          @id @default(uuid()) @db.VarChar(50)
  policyNo         String          @unique @map("policy_no") @db.VarChar(50)
  policyName       String?         @map("policy_name") @db.VarChar(100)
  applicantName    String          @map("applicant_name") @db.VarChar(100)
  holderType       HolderType      @map("holder_type")
  policyStatus     PolicyStatus    @default(enabled) @map("policy_status")
  effectiveDate    DateTime        @map("effective_date") @db.Date
  expiryDate       DateTime        @map("expiry_date") @db.Date
  currency         String          @default("CNY") @db.VarChar(10)
  totalPremium     Decimal?        @map("total_premium") @db.Decimal(18, 2)
  insuredCount     Int?            @map("insured_count")
  issueDate        DateTime?       @map("issue_date") @db.Date
  underwritingDate DateTime?       @map("underwriting_date") @db.Date
  remark           String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  products         PolicyProduct[]
  coveragePlans    CoveragePlan[]
  insureds         PolicyInsured[]

  @@index([policyStatus], map: "idx_policy_status")
  @@index([effectiveDate, expiryDate], map: "idx_policy_coverage_period")
  @@map("policy")
}

model CoveragePlan {
  id            String          @id @default(uuid()) @db.VarChar(50)
  policyId      String          @map("policy_id") @db.VarChar(50)
  planCode      String          @map("plan_code") @db.VarChar(50)
  planName      String          @map("plan_name") @db.VarChar(100)
  effectiveDate DateTime        @map("effective_date") @db.Date
  expiryDate    DateTime        @map("expiry_date") @db.Date
  status        ProductStatus   @default(active)
  remark        String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  policy        Policy          @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products      PolicyProduct[]
  insureds      PolicyInsured[]

  @@unique([policyId, planCode], map: "uk_coverage_plan_policy_id_plan_code")
  @@index([policyId], map: "idx_coverage_plan_policy_id")
  @@map("coverage_plan")
}

model PolicyProduct {
  id            String         @id @default(uuid()) @db.VarChar(50)
  policyId      String         @map("policy_id") @db.VarChar(50)
  coveragePlanId String?       @map("coverage_plan_id") @db.VarChar(50)
  productNo     String         @unique @map("product_no") @db.VarChar(50)
  productCode   String         @map("product_code") @db.VarChar(50)
  productName   String         @map("product_name") @db.VarChar(100)
  productStatus ProductStatus  @default(active) @map("product_status")
  effectiveDate DateTime       @map("effective_date") @db.Date
  expiryDate    DateTime       @map("expiry_date") @db.Date
  premium       Decimal?       @db.Decimal(18, 2)
  sumInsured    Decimal?       @map("sum_insured") @db.Decimal(18, 2)
  sequenceNo    Int?           @map("sequence_no")
  remark        String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  policy        Policy         @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coveragePlan  CoveragePlan?  @relation(fields: [coveragePlanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  benefits      PolicyBenefit[]

  @@unique([policyId, productCode], map: "uk_policy_product_policy_id_product_code")
  @@index([policyId], map: "idx_policy_product_policy_id")
  @@index([coveragePlanId], map: "idx_policy_product_coverage_plan_id")
  @@index([productStatus], map: "idx_policy_product_status")
  @@map("policy_product")
}

model CalculationParameter {
  id             String                        @id @default(uuid()) @db.VarChar(50)
  scope          CalculationParameterScope
  targetId       String                        @map("target_id") @db.VarChar(50)
  definitionId   String                        @map("definition_id") @db.VarChar(50)
  parameterValue String                        @map("parameter_value") @db.Text
  description    String?                       @db.Text
  enabled        Boolean                       @default(true)
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")

  definition     CalculationParameterDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([scope, targetId, definitionId], map: "uk_calculation_parameter_scope_target_definition")
  @@index([scope, targetId], map: "idx_calculation_parameter_scope_target")
  @@index([definitionId], map: "idx_calculation_parameter_definition_id")
  @@map("calculation_parameter")
}

model CalculationParameterDefinition {
  id               String                        @id @default(uuid()) @db.VarChar(50)
  parameterCode    String                        @unique @map("parameter_code") @db.VarChar(80)
  parameterName    String                        @unique @map("parameter_name") @db.VarChar(100)
  valueType        CalculationParameterValueType @map("value_type")
  unit             String?                       @db.VarChar(30)
  applicableScopes Json                          @map("applicable_scopes")
  description      String?                       @db.Text
  enabled          Boolean                       @default(true)
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  parameters       CalculationParameter[]

  @@map("calculation_parameter_definition")
}

model PolicyBenefit {
  id              String         @id @default(uuid()) @db.VarChar(50)
  policyProductId String         @map("policy_product_id") @db.VarChar(50)
  benefitNo       String         @unique @map("benefit_no") @db.VarChar(50)
  benefitCode     String         @map("benefit_code") @db.VarChar(50)
  benefitName     String         @map("benefit_name") @db.VarChar(100)
  benefitStatus   BenefitStatus  @default(active) @map("benefit_status")
  effectiveDate   DateTime       @map("effective_date") @db.Date
  expiryDate      DateTime       @map("expiry_date") @db.Date
  sequenceNo      Int?           @map("sequence_no")
  claimableFlag   Boolean        @default(true) @map("claimable_flag")
  remark          String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  policyProduct   PolicyProduct  @relation(fields: [policyProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([policyProductId, benefitCode], map: "uk_policy_benefit_product_id_benefit_code")
  @@index([policyProductId], map: "idx_policy_benefit_policy_product_id")
  @@index([benefitStatus], map: "idx_policy_benefit_status")
  @@map("policy_benefit")
}

model InsuredPerson {
  id               String             @id @default(uuid()) @db.VarChar(50)
  insuredNo        String             @unique @map("insured_no") @db.VarChar(50)
  name             String             @db.VarChar(100)
  gender           Gender?            
  birthDate        DateTime?          @map("birth_date") @db.Date
  idType           IdType?            @map("id_type")
  idNo             String?            @map("id_no") @db.VarChar(50)
  phone            String?            @db.VarChar(30)
  occupationCode   String?            @map("occupation_code") @db.VarChar(50)
  occupationName   String?            @map("occupation_name") @db.VarChar(100)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  policies         PolicyInsured[]

  @@unique([idType, idNo], map: "uk_insured_person_id_type_id_no")
  @@index([name], map: "idx_insured_person_name")
  @@map("insured_person")
}

model PolicyInsured {
  id              String         @id @default(uuid()) @db.VarChar(50)
  policyId        String         @map("policy_id") @db.VarChar(50)
  coveragePlanId  String?        @map("coverage_plan_id") @db.VarChar(50)
  insuredPersonId String         @map("insured_person_id") @db.VarChar(50)
  effectiveDate   DateTime       @map("effective_date") @db.Date
  expiryDate      DateTime       @map("expiry_date") @db.Date
  joinDate        DateTime?      @map("join_date") @db.Date
  leaveDate       DateTime?      @map("leave_date") @db.Date
  insuredRole     InsuredRole?   @map("insured_role")
  remark          String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  policy          Policy         @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coveragePlan    CoveragePlan?  @relation(fields: [coveragePlanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  insuredPerson   InsuredPerson  @relation(fields: [insuredPersonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([policyId, insuredPersonId], map: "uk_policy_insured_policy_id_insured_person_id")
  @@index([policyId], map: "idx_policy_insured_policy_id")
  @@index([coveragePlanId], map: "idx_policy_insured_coverage_plan_id")
  @@index([insuredPersonId], map: "idx_policy_insured_insured_person_id")
  @@map("policy_insured")
}

model ClaimCase {
  id               String             @id @default(uuid()) @db.VarChar(50)
  caseNo           String             @unique @map("case_no") @db.VarChar(50)
  policyId         String             @map("policy_id") @db.VarChar(50)
  policyInsuredId  String             @map("policy_insured_id") @db.VarChar(50)
  insuredPersonId  String             @map("insured_person_id") @db.VarChar(50)
  eventId          String             @map("event_id") @db.VarChar(50)
  reportDate       DateTime           @map("report_date") @db.Date
  reportChannel    ClaimReportChannel @map("report_channel")
  status           ClaimCaseStatus    @default(registered)
  remark           String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([policyId], map: "idx_claim_case_policy_id")
  @@index([policyInsuredId], map: "idx_claim_case_policy_insured_id")
  @@index([insuredPersonId], map: "idx_claim_case_insured_person_id")
  @@index([eventId], map: "idx_claim_case_event_id")
  @@index([reportDate], map: "idx_claim_case_report_date")
  @@index([status], map: "idx_claim_case_status")
  @@map("claim_case")
}

model ClaimParty {
  id                String         @id @default(uuid()) @db.VarChar(50)
  claimCaseId       String         @map("claim_case_id") @db.VarChar(50)
  role              ClaimPartyRole
  name              String         @db.VarChar(100)
  gender            Gender         @default(unknown)
  birthDate         DateTime?      @map("birth_date") @db.Date
  idType            IdType         @default(id_card) @map("id_type")
  idNo              String         @map("id_no") @db.VarChar(50)
  idValidFrom       DateTime?      @map("id_valid_from") @db.Date
  idValidTo         DateTime?      @map("id_valid_to") @db.Date
  idLongTerm        Boolean        @default(false) @map("id_long_term")
  address           String?        @db.VarChar(300)
  phone             String         @db.VarChar(30)
  relationToInsured String?        @map("relation_to_insured") @db.VarChar(50)
  bankName          String?        @map("bank_name") @db.VarChar(100)
  bankAccountName   String?        @map("bank_account_name") @db.VarChar(100)
  bankAccountNo     String?        @map("bank_account_no") @db.VarChar(80)
  paymentMethod     ClaimPaymentMethod? @map("payment_method")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([claimCaseId, role], map: "uk_claim_party_case_role")
  @@index([claimCaseId], map: "idx_claim_party_case_id")
  @@index([idNo], map: "idx_claim_party_id_no")
  @@map("claim_party")
}

model ClaimEvent {
  id                 String         @id @default(uuid()) @db.VarChar(50)
  eventNo            String         @unique @map("event_no") @db.VarChar(50)
  insuredPersonId    String         @map("insured_person_id") @db.VarChar(50)
  eventType          ClaimEventType @map("event_type")
  occurredDate       DateTime       @map("occurred_date") @db.Date
  administrativeArea String         @map("administrative_area") @db.VarChar(200)
  detailedAddress    String?        @map("detailed_address") @db.VarChar(300)
  hospitalName       String?        @map("hospital_name") @db.VarChar(150)
  diagnosis          String?        @db.VarChar(300)
  description        String         @db.Text
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([insuredPersonId, occurredDate], map: "idx_claim_event_person_date")
  @@index([eventType], map: "idx_claim_event_type")
  @@map("claim_event")
}

model ClaimAttachment {
  id          String                  @id @default(uuid()) @db.VarChar(50)
  claimCaseId String                  @map("claim_case_id") @db.VarChar(50)
  uploadId    String                  @unique @map("upload_id") @db.VarChar(50)
  category    ClaimAttachmentCategory
  fileName    String                  @map("file_name") @db.VarChar(200)
  mimeType    String                  @map("mime_type") @db.VarChar(100)
  fileSize    Int                     @map("file_size")
  storageKey  String?                 @map("storage_key") @db.VarChar(500)
  createdAt   DateTime                @default(now()) @map("created_at")

  @@index([claimCaseId], map: "idx_claim_attachment_case_id")
  @@index([category], map: "idx_claim_attachment_category")
  @@map("claim_attachment")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.VarChar(50)
  scope        String   @db.VarChar(100)
  operationKey String   @map("operation_key") @db.VarChar(200)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  status       String   @db.VarChar(20)
  response     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([scope, operationKey], map: "uk_idempotency_scope_operation_key")
  @@index([createdAt], map: "idx_idempotency_created_at")
  @@map("idempotency_record")
}
