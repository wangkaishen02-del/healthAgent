generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum HolderType {
  group
  company
}

enum PolicyStatus {
  enabled
  disabled
}

enum ProductStatus {
  active
  inactive
}

enum BenefitStatus {
  active
  inactive
}

enum Gender {
  male
  female
  unknown
}

enum IdType {
  id_card
  passport
  other
}

enum InsuredRole {
  employee
  spouse
  child
  parent
  other
}

enum CalculationParameterScope {
  policy
  plan
  product
  benefit
}

enum CalculationParameterValueType {
  text
  number
  percentage
  amount
  boolean
}

enum ClaimCaseStatus {
  registered
  entering
  calculating
  reviewing
  completed
  cancelled
}

enum ClaimPartyRole {
  insured
  applicant
  payee
}

enum ClaimReportChannel {
  online
  phone
  counter
  other
}

enum ClaimPaymentMethod {
  pending
  bank_transfer
  cash
  other
}

enum ClaimAttachmentCategory {
  application
  identity
  medical
  invoice
  bank
  other
}

enum OcrJobStatus {
  queued
  processing
  succeeded
  failed
}

model Policy {
  id               String       @id @default(uuid()) @db.VarChar(50)
  policyNo         String       @unique @map("policy_no") @db.VarChar(50)
  policyName       String?      @map("policy_name") @db.VarChar(100)
  applicantName    String       @map("applicant_name") @db.VarChar(100)
  holderType       HolderType   @map("holder_type")
  policyStatus     PolicyStatus @default(enabled) @map("policy_status")
  effectiveDate    DateTime     @map("effective_date") @db.Date
  expiryDate       DateTime     @map("expiry_date") @db.Date
  currency         String       @default("CNY") @db.VarChar(10)
  totalPremium     Decimal?     @map("total_premium") @db.Decimal(18, 2)
  insuredCount     Int?         @map("insured_count")
  issueDate        DateTime?    @map("issue_date") @db.Date
  underwritingDate DateTime?    @map("underwriting_date") @db.Date
  remark           String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  products      PolicyProduct[]
  coveragePlans CoveragePlan[]
  insureds      PolicyInsured[]

  @@index([policyStatus], map: "idx_policy_status")
  @@index([effectiveDate, expiryDate], map: "idx_policy_coverage_period")
  @@map("policy")
}

model CoveragePlan {
  id            String        @id @default(uuid()) @db.VarChar(50)
  policyId      String        @map("policy_id") @db.VarChar(50)
  planCode      String        @map("plan_code") @db.VarChar(50)
  planName      String        @map("plan_name") @db.VarChar(100)
  effectiveDate DateTime      @map("effective_date") @db.Date
  expiryDate    DateTime      @map("expiry_date") @db.Date
  status        ProductStatus @default(active)
  remark        String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  policy   Policy          @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products PolicyProduct[]
  insureds PolicyInsured[]

  @@unique([policyId, planCode], map: "uk_coverage_plan_policy_id_plan_code")
  @@index([policyId], map: "idx_coverage_plan_policy_id")
  @@map("coverage_plan")
}

model PolicyProduct {
  id             String        @id @default(uuid()) @db.VarChar(50)
  policyId       String        @map("policy_id") @db.VarChar(50)
  coveragePlanId String?       @map("coverage_plan_id") @db.VarChar(50)
  productNo      String        @unique @map("product_no") @db.VarChar(50)
  productCode    String        @map("product_code") @db.VarChar(50)
  productName    String        @map("product_name") @db.VarChar(100)
  productStatus  ProductStatus @default(active) @map("product_status")
  effectiveDate  DateTime      @map("effective_date") @db.Date
  expiryDate     DateTime      @map("expiry_date") @db.Date
  premium        Decimal?      @db.Decimal(18, 2)
  sumInsured     Decimal?      @map("sum_insured") @db.Decimal(18, 2)
  sequenceNo     Int?          @map("sequence_no")
  remark         String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  policy       Policy          @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coveragePlan CoveragePlan?   @relation(fields: [coveragePlanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  benefits     PolicyBenefit[]

  @@unique([policyId, productCode], map: "uk_policy_product_policy_id_product_code")
  @@index([policyId], map: "idx_policy_product_policy_id")
  @@index([coveragePlanId], map: "idx_policy_product_coverage_plan_id")
  @@index([productStatus], map: "idx_policy_product_status")
  @@map("policy_product")
}

model CalculationParameter {
  id             String                    @id @default(uuid()) @db.VarChar(50)
  scope          CalculationParameterScope
  targetId       String                    @map("target_id") @db.VarChar(50)
  definitionId   String                    @map("definition_id") @db.VarChar(50)
  parameterValue String                    @map("parameter_value") @db.Text
  description    String?                   @db.Text
  enabled        Boolean                   @default(true)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  definition CalculationParameterDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([scope, targetId, definitionId], map: "uk_calculation_parameter_scope_target_definition")
  @@index([scope, targetId], map: "idx_calculation_parameter_scope_target")
  @@index([definitionId], map: "idx_calculation_parameter_definition_id")
  @@map("calculation_parameter")
}

model CalculationParameterDefinition {
  id               String                        @id @default(uuid()) @db.VarChar(50)
  parameterCode    String                        @unique @map("parameter_code") @db.VarChar(80)
  parameterName    String                        @unique @map("parameter_name") @db.VarChar(100)
  valueType        CalculationParameterValueType @map("value_type")
  unit             String?                       @db.VarChar(30)
  applicableScopes Json                          @map("applicable_scopes")
  description      String?                       @db.Text
  enabled          Boolean                       @default(true)
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  parameters CalculationParameter[]

  @@map("calculation_parameter_definition")
}

model PolicyBenefit {
  id              String        @id @default(uuid()) @db.VarChar(50)
  policyProductId String        @map("policy_product_id") @db.VarChar(50)
  benefitNo       String        @unique @map("benefit_no") @db.VarChar(50)
  benefitCode     String        @map("benefit_code") @db.VarChar(50)
  benefitName     String        @map("benefit_name") @db.VarChar(100)
  benefitStatus   BenefitStatus @default(active) @map("benefit_status")
  effectiveDate   DateTime      @map("effective_date") @db.Date
  expiryDate      DateTime      @map("expiry_date") @db.Date
  sequenceNo      Int?          @map("sequence_no")
  claimableFlag   Boolean       @default(true) @map("claimable_flag")
  remark          String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  policyProduct PolicyProduct @relation(fields: [policyProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([policyProductId, benefitCode], map: "uk_policy_benefit_product_id_benefit_code")
  @@index([policyProductId], map: "idx_policy_benefit_policy_product_id")
  @@index([benefitStatus], map: "idx_policy_benefit_status")
  @@map("policy_benefit")
}

model InsuredPerson {
  id             String    @id @default(uuid()) @db.VarChar(50)
  insuredNo      String    @unique @map("insured_no") @db.VarChar(50)
  name           String    @db.VarChar(100)
  gender         Gender?
  birthDate      DateTime? @map("birth_date") @db.Date
  idType         IdType?   @map("id_type")
  idNo           String?   @map("id_no") @db.VarChar(50)
  phone          String?   @db.VarChar(30)
  occupationCode String?   @map("occupation_code") @db.VarChar(50)
  occupationName String?   @map("occupation_name") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  policies PolicyInsured[]

  @@unique([idType, idNo], map: "uk_insured_person_id_type_id_no")
  @@index([name], map: "idx_insured_person_name")
  @@map("insured_person")
}

model PolicyInsured {
  id              String       @id @default(uuid()) @db.VarChar(50)
  policyId        String       @map("policy_id") @db.VarChar(50)
  coveragePlanId  String?      @map("coverage_plan_id") @db.VarChar(50)
  insuredPersonId String       @map("insured_person_id") @db.VarChar(50)
  effectiveDate   DateTime     @map("effective_date") @db.Date
  expiryDate      DateTime     @map("expiry_date") @db.Date
  joinDate        DateTime?    @map("join_date") @db.Date
  leaveDate       DateTime?    @map("leave_date") @db.Date
  insuredRole     InsuredRole? @map("insured_role")
  remark          String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coveragePlan  CoveragePlan? @relation(fields: [coveragePlanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  insuredPerson InsuredPerson @relation(fields: [insuredPersonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([policyId, insuredPersonId], map: "uk_policy_insured_policy_id_insured_person_id")
  @@index([policyId], map: "idx_policy_insured_policy_id")
  @@index([coveragePlanId], map: "idx_policy_insured_coverage_plan_id")
  @@index([insuredPersonId], map: "idx_policy_insured_insured_person_id")
  @@map("policy_insured")
}

model ClaimCase {
  id              String             @id @default(uuid()) @db.VarChar(50)
  caseNo          String             @unique @map("case_no") @db.VarChar(50)
  policyId        String             @map("policy_id") @db.VarChar(50)
  policyInsuredId String             @map("policy_insured_id") @db.VarChar(50)
  insuredPersonId String             @map("insured_person_id") @db.VarChar(50)
  eventId         String             @map("event_id") @db.VarChar(50)
  reportDate      DateTime           @map("report_date") @db.Date
  reportChannel   ClaimReportChannel @map("report_channel")
  status          ClaimCaseStatus    @default(registered)
  currentHandlerUserId String        @default("default-user") @map("current_handler_user_id") @db.VarChar(50)
  currentHandlerName   String        @default("默认用户") @map("current_handler_name") @db.VarChar(100)
  remark          String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([policyId], map: "idx_claim_case_policy_id")
  @@index([policyInsuredId], map: "idx_claim_case_policy_insured_id")
  @@index([insuredPersonId], map: "idx_claim_case_insured_person_id")
  @@index([eventId], map: "idx_claim_case_event_id")
  @@index([reportDate], map: "idx_claim_case_report_date")
  @@index([status], map: "idx_claim_case_status")
  @@index([updatedAt], map: "idx_claim_case_updated_at")
  @@index([status, updatedAt], map: "idx_claim_case_status_updated_at")
  @@index([currentHandlerUserId, status, updatedAt], map: "idx_claim_case_handler_status_updated")
  @@map("claim_case")
}

model ClaimParty {
  id                String              @id @default(uuid()) @db.VarChar(50)
  claimCaseId       String              @map("claim_case_id") @db.VarChar(50)
  role              ClaimPartyRole
  name              String              @db.VarChar(100)
  gender            Gender              @default(unknown)
  birthDate         DateTime?           @map("birth_date") @db.Date
  idType            IdType              @default(id_card) @map("id_type")
  idNo              String              @map("id_no") @db.VarChar(50)
  idValidFrom       DateTime?           @map("id_valid_from") @db.Date
  idValidTo         DateTime?           @map("id_valid_to") @db.Date
  idLongTerm        Boolean             @default(false) @map("id_long_term")
  address           String?             @db.VarChar(300)
  phone             String              @db.VarChar(30)
  relationToInsured String?             @map("relation_to_insured") @db.VarChar(50)
  bankName          String?             @map("bank_name") @db.VarChar(100)
  bankAccountName   String?             @map("bank_account_name") @db.VarChar(100)
  bankAccountNo     String?             @map("bank_account_no") @db.VarChar(80)
  paymentMethod     ClaimPaymentMethod? @map("payment_method")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([claimCaseId, role], map: "uk_claim_party_case_role")
  @@index([claimCaseId], map: "idx_claim_party_case_id")
  @@index([idNo], map: "idx_claim_party_id_no")
  @@map("claim_party")
}

model ClaimCaseRemark {
  id          String   @id @default(uuid()) @db.VarChar(50)
  claimCaseId String   @map("claim_case_id") @db.VarChar(50)
  stage       String   @db.VarChar(30)
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([claimCaseId, createdAt], map: "idx_claim_case_remark_case_created")
  @@map("claim_case_remark")
}

model ClaimCaseTransition {
  id             String   @id @default(uuid()) @db.VarChar(50)
  claimCaseId    String   @map("claim_case_id") @db.VarChar(50)
  action         String   @db.VarChar(40)
  fromStatus     String?  @map("from_status") @db.VarChar(30)
  toStatus       String   @map("to_status") @db.VarChar(30)
  operatorUserId String   @map("operator_user_id") @db.VarChar(50)
  operatorName   String   @map("operator_name") @db.VarChar(100)
  targetUserId   String   @default("default-user") @map("target_user_id") @db.VarChar(50)
  targetUserName String   @default("默认用户") @map("target_user_name") @db.VarChar(100)
  description    String?  @db.VarChar(300)
  occurredAt     DateTime @default(now()) @map("occurred_at")

  @@index([claimCaseId, occurredAt], map: "idx_claim_case_transition_case_occurred")
  @@index([operatorUserId, occurredAt], map: "idx_claim_case_transition_operator_occurred")
  @@index([toStatus, occurredAt], map: "idx_claim_case_transition_status_occurred")
  @@index([targetUserId, occurredAt], map: "idx_claim_case_transition_target_occurred")
  @@map("claim_case_transition")
}

model AppUserSnapshot {
  userId      String   @id @map("user_id") @db.VarChar(100)
  username    String   @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(150)
  email       String?  @db.VarChar(200)
  roles       Json
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@index([username], map: "idx_app_user_snapshot_username")
  @@index([lastSeenAt], map: "idx_app_user_snapshot_last_seen")
  @@map("app_user_snapshot")
}

model OperationAudit {
  id            String   @id @default(uuid()) @db.VarChar(50)
  actorUserId   String   @map("actor_user_id") @db.VarChar(100)
  actorUsername String   @map("actor_username") @db.VarChar(100)
  actorName     String   @map("actor_name") @db.VarChar(150)
  actorRoles    Json     @map("actor_roles")
  method        String   @db.VarChar(10)
  path          String   @db.VarChar(300)
  resourceType  String   @map("resource_type") @db.VarChar(100)
  resourceId    String?  @map("resource_id") @db.VarChar(100)
  outcome       String   @db.VarChar(20)
  statusCode    Int      @map("status_code")
  errorCode     String?  @map("error_code") @db.VarChar(100)
  requestId     String   @map("request_id") @db.VarChar(100)
  ipAddress     String?  @map("ip_address") @db.VarChar(100)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([actorUserId, occurredAt], map: "idx_operation_audit_actor_time")
  @@index([resourceType, resourceId, occurredAt], map: "idx_operation_audit_resource_time")
  @@index([outcome, occurredAt], map: "idx_operation_audit_outcome_time")
  @@index([requestId], map: "idx_operation_audit_request_id")
  @@map("operation_audit")
}

model ClaimEvent {
  id                 String   @id @default(uuid()) @db.VarChar(50)
  eventNo            String   @unique @map("event_no") @db.VarChar(50)
  insuredPersonId    String   @map("insured_person_id") @db.VarChar(50)
  eventType          String   @map("event_type") @db.VarChar(30)
  occurredDate       DateTime @map("occurred_date") @db.Date
  administrativeArea String   @map("administrative_area") @db.VarChar(200)
  detailedAddress    String?  @map("detailed_address") @db.VarChar(300)
  hospitalName       String?  @map("hospital_name") @db.VarChar(150)
  diagnosis          String?  @db.VarChar(300)
  description        String   @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([insuredPersonId, occurredDate], map: "idx_claim_event_person_date")
  @@index([insuredPersonId, eventType, occurredDate], map: "idx_claim_event_person_type_date")
  @@index([eventType], map: "idx_claim_event_type")
  @@map("claim_event")
}

model ClaimAttachment {
  id          String                  @id @default(uuid()) @db.VarChar(50)
  claimCaseId String                  @map("claim_case_id") @db.VarChar(50)
  uploadId    String                  @unique @map("upload_id") @db.VarChar(50)
  category    ClaimAttachmentCategory
  fileName    String                  @map("file_name") @db.VarChar(200)
  mimeType    String                  @map("mime_type") @db.VarChar(100)
  fileSize    Int                     @map("file_size")
  storageKey  String?                 @map("storage_key") @db.VarChar(500)
  createdAt   DateTime                @default(now()) @map("created_at")

  @@index([claimCaseId], map: "idx_claim_attachment_case_id")
  @@index([category], map: "idx_claim_attachment_category")
  @@map("claim_attachment")
}

model ClaimAttachmentOcr {
  id                       String       @id @default(uuid()) @db.VarChar(50)
  uploadId                 String       @unique @map("upload_id") @db.VarChar(50)
  status                   OcrJobStatus @default(queued)
  documentType             String?      @map("document_type") @db.VarChar(30)
  classificationConfidence Float?       @map("classification_confidence")
  rawText                  String?      @map("raw_text") @db.Text
  lines                    Json?
  structuredData           Json?        @map("structured_data")
  engine                   String?      @db.VarChar(50)
  durationMs               Int?         @map("duration_ms")
  pageCount                Int?         @map("page_count")
  attempts                 Int          @default(0)
  lastError                String?      @map("last_error") @db.Text
  queuedAt                 DateTime     @default(now()) @map("queued_at")
  startedAt                DateTime?    @map("started_at")
  completedAt              DateTime?    @map("completed_at")
  nextAttemptAt            DateTime     @default(now()) @map("next_attempt_at")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt, queuedAt], map: "idx_claim_attachment_ocr_queue")
  @@index([documentType], map: "idx_claim_attachment_ocr_document_type")
  @@map("claim_attachment_ocr")
}

model ClaimCaseEventEntry {
  id           String   @id @default(uuid()) @db.VarChar(50)
  claimCaseId  String   @map("claim_case_id") @db.VarChar(50)
  eventType    String   @map("event_type") @db.VarChar(30)
  occurredDate DateTime @map("occurred_date") @db.Date
  location     String?  @db.VarChar(300)
  description  String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([claimCaseId, occurredDate], map: "idx_claim_case_event_entry_case_date")
  @@map("claim_case_event_entry")
}

model ClaimCaseDiseaseEntry {
  id            String   @id @default(uuid()) @db.VarChar(50)
  claimCaseId   String   @map("claim_case_id") @db.VarChar(50)
  diseaseName   String   @map("disease_name") @db.VarChar(200)
  icdCode       String?  @map("icd_code") @db.VarChar(50)
  diagnosisDate DateTime @map("diagnosis_date") @db.Date
  hospital      String   @db.VarChar(200)
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([claimCaseId, diagnosisDate], map: "idx_claim_case_disease_entry_case_date")
  @@map("claim_case_disease_entry")
}

model SystemDictionary {
  id             Int      @id @default(autoincrement())
  dictionaryType String   @map("dictionary_type") @db.VarChar(60)
  typeName       String   @map("type_name") @db.VarChar(100)
  itemCode       String   @map("item_code") @db.VarChar(30)
  itemName       String   @map("item_name") @db.VarChar(150)
  sequenceNo     Int      @default(0) @map("sequence_no")
  enabled        Boolean  @default(true)
  description    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([dictionaryType, itemCode], map: "uk_system_dictionary_type_code")
  @@index([dictionaryType, enabled, sequenceNo], map: "idx_system_dictionary_type_enabled_sequence")
  @@map("system_dictionary")
}

model CalculationParameterCatalog {
  id             Int      @id @default(autoincrement())
  parameterCode  String   @unique @default(dbgenerated()) @map("parameter_code") @db.VarChar(6)
  policyId       String?  @map("policy_id") @db.VarChar(50)
  category       String   @db.VarChar(30)
  parameterName  String   @map("parameter_name") @db.VarChar(100)
  valueType      String   @map("value_type") @db.VarChar(30)
  unit           String?  @db.VarChar(30)
  dictionaryType String?  @map("dictionary_type") @db.VarChar(60)
  defaultValue   String?  @map("default_value") @db.Text
  custom         Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([policyId, category, parameterName], map: "idx_calculation_parameter_catalog_policy_category")
  @@index([dictionaryType], map: "idx_calculation_parameter_catalog_dictionary_type")
  @@map("calculation_parameter_catalog")
}

model CalculationLedgerParameterCatalog {
  id                  Int      @id @default(autoincrement())
  parameterCode       String   @unique @default(dbgenerated()) @map("parameter_code") @db.VarChar(6)
  policyId            String?  @map("policy_id") @db.VarChar(50)
  parameterName       String   @map("parameter_name") @db.VarChar(100)
  valueType           String   @map("value_type") @db.VarChar(30)
  unit                String?  @db.VarChar(30)
  timeRange           String   @map("time_range") @db.VarChar(20)
  responsibilityRange String   @map("responsibility_range") @db.VarChar(30)
  defaultValue        String?  @map("default_value") @db.Text
  custom              Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([policyId, parameterName], map: "idx_calculation_ledger_parameter_catalog_policy")
  @@map("calculation_ledger_parameter_catalog")
}

model BenefitCalculationFormula {
  id              Int      @id @default(autoincrement())
  policyId        String   @map("policy_id") @db.VarChar(50)
  benefitId       String   @unique @map("benefit_id") @db.VarChar(50)
  formulaName     String   @map("formula_name") @db.VarChar(150)
  matchExpression String?  @map("match_expression") @db.Text
  steps           Json
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

