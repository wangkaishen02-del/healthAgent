model ClaimBill {
  id                   String    @id @default(uuid()) @db.VarChar(50)
  claimCaseId          String    @map("claim_case_id") @db.VarChar(50)
  invoiceCode          String    @default("") @map("invoice_code") @db.VarChar(50)
  invoiceNo            String    @default("") @map("invoice_no") @db.VarChar(100)
  checkCode            String    @default("") @map("check_code") @db.VarChar(100)
  billType             String    @default("") @map("bill_type") @db.VarChar(50)
  patientName          String    @default("") @map("patient_name") @db.VarChar(100)
  patientIdNo          String    @default("") @map("patient_id_no") @db.VarChar(50)
  visitNo              String    @default("") @map("visit_no") @db.VarChar(100)
  institution          String    @default("") @db.VarChar(200)
  department           String    @default("") @db.VarChar(100)
  billDate             DateTime  @map("bill_date") @db.Date
  admissionDate        DateTime? @map("admission_date") @db.Date
  dischargeDate        DateTime? @map("discharge_date") @db.Date
  diagnosis            String    @default("") @db.Text
  medicalInsuranceType String    @default("") @map("medical_insurance_type") @db.VarChar(50)
  settlementNo         String    @default("") @map("settlement_no") @db.VarChar(100)
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2)
  cashier              String    @default("") @db.VarChar(100)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([claimCaseId], map: "idx_claim_bill_case")
  @@index([invoiceNo], map: "idx_claim_bill_invoice_no")
  @@map("claim_bill")
}

