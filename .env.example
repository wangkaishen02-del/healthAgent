# 默认使用本地 Ollama。
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_MS=90000
# Agent 日志默认只记录耗时、长度和摘要，不记录提示词或模型输出正文。
# 可选值：metadata（推荐）、redacted（仅本地排障）、off。
ASSISTANT_LOG_LEVEL=metadata

# 本地 Docker PostgreSQL。项目使用 relationMode = "prisma"，数据库不创建外键。
DATABASE_URL="postgresql://healthagent:healthagent_local@127.0.0.1:54329/healthagent?schema=public"

# NestJS 正式业务 API。迁移期与 Next.js 并行运行。
NEST_API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Keycloak 登录与角色权限。正式环境保持 AUTH_ENABLED=true。
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://127.0.0.1:18081/realms/healthagent
KEYCLOAK_AUDIENCE=healthagent-api
KEYCLOAK_WEB_CLIENT_ID=healthagent-web
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://127.0.0.1:18081/realms/healthagent
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=healthagent-web
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_change_me
KEYCLOAK_DB_PASSWORD=keycloak_local_change_me

# 本机 Docker OCR 服务，仅监听回环地址，不对局域网或公网开放。
OCR_URL=http://127.0.0.1:18080
OCR_POLL_INTERVAL_MS=1000
OCR_TIMEOUT_MS=120000
OCR_JOB_LEASE_MS=180000
OCR_MAX_ATTEMPTS=3

# 使用 DeepSeek 做速度对比时，在本机 .env.local 中填写以下配置；不要提交真实密钥。
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
