HEALTHAGENT_HOST=localhost
PUBLIC_BASE_URL=https://localhost

APP_DB_NAME=healthagent
APP_DB_USER=healthagent
APP_DB_PASSWORD=replace-with-a-long-random-password

KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ASSISTANT_TASK_CACHE_MAX=500
ASSISTANT_TASK_CACHE_TTL_MS=3600000

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_ON_START=true
BACKUP_ONCE=false
